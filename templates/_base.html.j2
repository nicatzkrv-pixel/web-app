<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="{{ t('tagline') }}">
<meta name="theme-color" content="#0f3b3d">
<title>{% block title %}{{ t('site_name') }}{% endblock %}</title>
<link rel="preload" href="{{ base }}assets/fonts/atkinson-hyperlegible-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ base }}assets/fonts/barlow-semi-condensed-600-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ base }}assets/radar.css">
<link rel="icon" href="{{ base }}assets/favicon.svg" type="image/svg+xml">
<script>document.documentElement.classList.replace('no-js','js')</script>
</head>
<body class="page-{{ page }}">
<a class="skip" href="#main">{{ t('skip') }}</a>
<header class="mast">
  <div class="mast__inner">
    <a class="mark" href="{{ base }}index.html" aria-label="{{ t('site_name') }}, {{ t('nav_today') }}">
      <svg class="mark__glyph" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="5"/><path d="M8 16h16M8 16a8 8 0 0 1 16 0" /><circle cx="16" cy="16" r="2.4"/></svg>
      <span class="mark__name">{{ t('site_name') }}</span>
      <span class="mark__for">{{ t('for_bank') }}</span>
    </a>
    <nav class="mast__nav" aria-label="Bulletins">
      {% block nav %}{% endblock %}
      <a class="navlink{% if page == 'archive' %} is-here{% endif %}" href="{{ base }}archive/index.html"{% if page == 'archive' %} aria-current="page"{% endif %}>{{ t('nav_archive') }}</a>
    </nav>
  </div>
  {% block board %}{% endblock %}
</header>
<main id="main" class="main">
{% block main %}{% endblock %}
</main>
<footer class="foot">
  <div class="foot__inner">
    <section class="foot__how" aria-labelledby="how">
      <h2 id="how">{{ t('how_scored') }}</h2>
      <p>{{ t('how_scored_body') }}</p>
      <p class="foot__formula">{{ t('formula') }}</p>
    </section>
    <ul class="foot__links">
      <li><a href="{{ base }}archive/index.html">{{ t('nav_archive') }}</a></li>
      <li><a href="{{ repo_url }}/issues/new?title=Source+suggestion">{{ t('suggest_source') }}</a></li>
    </ul>
  </div>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
