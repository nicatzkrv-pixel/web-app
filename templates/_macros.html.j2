{# Score ring: SVG arc filled to score/10, number in the middle. #}
{% macro ring(score, size='md') -%}
<span class="ring ring--{{ size }}" style="--p:{{ '%.3f'|format(score / 10) }}" role="img" aria-label="{{ t('col_score') }} {{ '%.1f'|format(score) }} {{ t('out_of_ten') }}">
  <svg viewBox="0 0 48 48" aria-hidden="true"><circle class="ring__track" cx="24" cy="24" r="20"/><circle class="ring__arc" cx="24" cy="24" r="20" pathLength="100"/></svg>
  <span class="ring__num" data-countup="{{ '%.1f'|format(score) }}" aria-hidden="true">{{ '%.1f'|format(score) }}</span>
</span>
{%- endmacro %}

{# Small score pill for compact rows and the archive. Kept as .tile for older tests. #}
{% macro tile(score, size='sm', flip=false, idx=0) -%}
<span class="tile score-pill" role="img" aria-label="{{ t('col_score') }} {{ '%.1f'|format(score) }}">{{ '%.1f'|format(score) }}</span>
{%- endmacro %}

{% macro status(s) -%}
<span class="status status--{{ s }}"><span class="status__lamp" aria-hidden="true"></span>{{ t('status_' ~ s) }}</span>
{%- endmacro %}

{% macro region_chip(item) -%}
<span class="chip chip--{{ item.region|lower }}"><span class="chip__dot" aria-hidden="true"></span>
  {%- if item.region == 'Azerbaijan' %}{{ t('region_Azerbaijan') }}
  {%- elif item.place and item.place not in ('Not stated', 'Multiple') %}{{ item.place }}
  {%- elif item.country and item.country not in ('Not stated', 'Multiple') %}{{ item.country }}
  {%- else %}{{ t('region_' ~ item.region) }}{% endif -%}
</span>
{%- endmacro %}

{% macro maths(item) -%}
<details class="maths">
  <summary>
    <span class="sub"><abbr title="{{ t('applicability') }}">{{ t('applicability_short') }}</abbr> <b>{{ item.applicability }}</b></span>
    <span class="sub"><abbr title="{{ t('novelty') }}">{{ t('novelty_short') }}</abbr> <b>{{ item.novelty }}</b></span>
    <span class="maths__open">{{ t('score_maths') }}</span>
  </summary>
  <p class="maths__line">
    0.6 × {{ item.applicability }} + 0.4 × {{ item.novelty }}
    {%- if item.bonus %} + {{ item.bonus }} {{ t('local_bonus') if item.region == 'Azerbaijan' else t('nearby_bonus') }}{% endif %}
    {%- if item.penalty %} − {{ item.penalty }} {{ t('repeat_penalty') }}{% endif %}
    = <b>{{ '%.1f'|format(item.score) }}</b>
  </p>
</details>
{%- endmacro %}

{# variant: 'pick' (top picks cards), 'local' and 'row' (lists) #}
{% macro item_row(item, variant='row', idx=0, lead=false) -%}
<article class="item item--{{ variant }}{% if lead %} item--lead{% endif %}{% if item.region == 'Azerbaijan' %} is-local{% endif %}" id="{{ variant }}-{{ item.id }}"
  data-item data-blip="{{ item.id }}" data-category="{{ item.category }}" data-region="{{ item.region }}" data-score="{{ '%.1f'|format(item.score) }}"
  data-search="{{ (item.title ~ ' ' ~ item.idea ~ ' ' ~ item.summary ~ ' ' ~ item.country ~ ' ' ~ item.publisher ~ ' ' ~ item.category)|lower }}"
  style="--i:{{ idx }}">
  <div class="item__score">
    {% if variant == 'pick' %}{{ ring(item.score, 'lg' if lead else 'md') }}{% else %}{{ tile(item.score) }}{% endif %}
  </div>
  <div class="item__body">
    <p class="item__idea"><span class="vh">{{ t('idea_label') }}: </span>{{ item.idea }}</p>
    <h3 class="item__title"><a href="{{ item.url }}" rel="noopener" target="_blank">{{ item.title }}<svg class="item__ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9"/></svg></a></h3>
    <p class="item__meta">
      <span class="item__pub">{{ item.publisher }}</span>
      {%- if item.published %}<time datetime="{{ item.published }}">{{ fmt_published(item.published) }}</time>{% endif %}
      {%- if item.also_in %}<span class="item__also">{{ t('also_in') }} {{ item.also_in[:3]|join(', ') }}</span>{% endif %}
      {%- if item.repeat_of %}<span class="item__repeat">{{ t('repeat_note') }} {{ fmt_date_short(item.repeat_of) }}</span>{% endif %}
    </p>
    {% if item.summary and item.summary != item.title %}<p class="item__summary">{{ item.summary }}</p>{% endif %}
    <div class="item__tags">
      <span class="chip chip--cat">{{ item.category }}</span>
      <span class="chip chip--kpi">{{ t('moves') }} {{ item.kpi }}</span>
      {{ maths(item) }}
    </div>
  </div>
  <div class="item__where">{{ region_chip(item) }}</div>
  <div class="item__status">{{ status(item.launch_status) }}</div>
</article>
{%- endmacro %}

{% macro section_head(title, id, intro=None, count=None) -%}
<div class="board__head">
  <h2 class="board__title" id="{{ id }}">{{ title }}{% if count is not none %} <span class="board__count">{{ count }}</span>{% endif %}</h2>
  {% if intro %}<p class="board__intro">{{ intro }}</p>{% endif %}
</div>
{%- endmacro %}
