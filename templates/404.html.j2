{% extends "_base.html.j2" %}
{% block title %}{{ t('not_found') }}, {{ t('site_name') }}{% endblock %}
{% block hero %}
<section class="hero hero--slim" aria-labelledby="hero-title" data-enter>
  <div class="hero__sky" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title"><span class="hero__words">{% for w in t('not_found').split(' ') %}<span class="w" style="--w:{{ loop.index }}">{{ w }}</span> {% endfor %}</span></h1>
      <div class="hero__actions"><a class="btn btn--light" href="{{ base }}index.html">{{ t('go_latest') }}</a></div>
    </div>
  </div>
</section>
{% endblock %}
